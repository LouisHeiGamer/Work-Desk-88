    "# Uniform-Cost Search (Dijkstra's Algorithm) Implementation in Python\n",
    "import heapq    # Priority queue implementation\n",
    "\n",
    "graph = {\n",
    "    \"S\": {\"A\": 2, \"C\": 5},\n",
    "    \"A\": {\"G\": 1},\n",
    "    \"B\": {\"A\": 4},\n",
    "    \"C\": {\"A\": 5, \"G\": 6, \"D\": 2},\n",
    "    \"D\": {\"B\": 4, \"E\": 3},\n",
    "    \"E\": {\"B\": 6, \"G\": 3},\n",
    "    \"G\": {\"D\": 7}\n",
    "}\n",
    "\n",
    "def dijkstra(graph, start, goal):\n",
    "    \"\"\"Finds the shortest path from 'start' to 'goal'.\"\"\"\n",
    "    pq = [(0, start, [start])]   # (cumulative_cost, current_node, path)\n",
    "    distances = {start: 0}\n",
    "\n",
    "    while pq:\n",
