   "source": [
    "# Lambda Function Defination\n",
    "def fl (a, b):\n",
    "    return a + b\n",
    "\n",
    "print(fl(3, 5))\n",
    "\n",
    "## Lambda Function Example 1\n",
    "f1 = lambda a,b : a+b\n",
    "print(f1(2, 4))\n",
    "\n",
    "## Lambda Function Example 2\n",
    "f2 = lambda a,b=3 : a+b\n",
    "print(f2(2))\n",
    "\n",
    "## Lambda Function Example 3\n",
    "f3 = lambda a,b=3 : a+b\n",
    "print(f3(2, 5))"
   ]
  }
